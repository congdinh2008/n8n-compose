    {
      "parameters": {
        "sendTo": "REPLACE_WITH_YOUR_OWN_EMAIL@gmail.com",
        "subject": "=🚨 [HIGH PRIORITY] {{ $json.subject }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html><head><style>\n  body { font-family: Arial; background: #FEF2F2; padding: 20px; }\n  .alert { background: white; border-left: 6px solid #DC2626; padding: 20px; border-radius: 6px; }\n  .alert h2 { color: #DC2626; margin: 0 0 12px 0; }\n  .meta { color: #6b7280; font-size: 13px; margin: 12px 0; }\n  .summary { background: #FEF3C7; padding: 12px; border-radius: 4px; margin: 12px 0; }\n  .reply-draft { background: #F0FDF4; border-left: 3px solid #059669; padding: 12px; margin: 12px 0; font-style: italic; }\n  .actions a { display: inline-block; background: #0B3D91; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; margin: 4px; }\n</style></head>\n<body>\n  <div class=\"alert\">\n    <h2>🚨 HIGH PRIORITY EMAIL</h2>\n    <div class=\"meta\">\n      <strong>From:</strong> {{ $json.from_name }} ({{ $json.from_email }})<br>\n      <strong>Subject:</strong> {{ $json.subject }}<br>\n      <strong>Received:</strong> {{ $json.received_at }}<br>\n      <strong>Reply deadline:</strong> within {{ $json.reply_deadline_hours }}h\n    </div>\n    <div class=\"summary\">\n      <strong>📝 Summary:</strong> {{ $json.summary_vi }}<br><br>\n      <strong>🔑 Key Points:</strong>\n      <ul>{{ $json.key_points.map(p => '<li>' + p + '</li>').join('') }}</ul>\n      <strong>🤖 AI Reasoning:</strong> {{ $json.reasoning }}\n    </div>\n    {{ $json.suggested_reply_draft ? '<div class=\"reply-draft\"><strong>💡 Suggested Reply:</strong><br>' + $json.suggested_reply_draft + '</div>' : '' }}\n    <div class=\"actions\">\n      <a href=\"https://mail.google.com/mail/u/0/#inbox/{{ $json.thread_id }}\">📧 Open in Gmail</a>\n    </div>\n  </div>\n</body></html>",
        "options": {}
      },
