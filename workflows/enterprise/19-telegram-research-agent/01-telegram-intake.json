      "id": "8c92052c-0b4d-47b5-9a24-56ba513e541e",
      "name": "Gemini Flash (Parse)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        832,
        1824
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "0oldd2GFNcujd72t",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
