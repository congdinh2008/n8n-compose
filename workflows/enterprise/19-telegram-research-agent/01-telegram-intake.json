    {
      "parameters": {
        "jsCode": "// Parse response từ Gemini và build row data\nconst rawText = $input.first().json.text || '';\nconst config = $('Set: Config Vars').first().json;\n\n// Làm sạch JSON response\nlet cleanText = rawText.trim();\ncleanText = cleanText.replace(/^```json\\s*/i, '').replace(/\\s*```$/, '');\ncleanText = cleanText.replace(/^```\\s*/, '').replace(/\\s*```$/, '');\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(cleanText);\n} catch (e) {\n  // Fallback nếu parse thất bại\n  parsed = {\n    title: config.text.substring(0, 80),\n    research_type: 'other',\n    language: 'vi'\n  };\n}\n\nconst requestId = 'REQ-' + Date.now();\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    request_id: requestId,\n    title: (parsed.title || config.text.substring(0, 80)).trim(),\n    raw_request: config.text,\n    research_type: parsed.research_type || 'other',\n    chat_id: config.chat_id,\n    user_id: config.user_id,\n    username: config.username,\n    status: 'queue',\n    created_at: now,\n    updated_at: now,\n    // Pass config\n    SHEET_ID: config.SHEET_ID,\n    SHEET_NAME: config.SHEET_NAME\n  }\n}];"
      },
