    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Phân tích yêu cầu research sau và trích xuất thông tin cần thiết.\n\nYÊU CẦU: {{ $json.text }}\n\nHãy trả về JSON (không có markdown, không có ```):  \n{\n  \"title\": \"Tiêu đề ngắn gọn mô tả chủ đề nghiên cứu (tối đa 80 ký tự, tiếng Việt)\",\n  \"research_type\": \"market_analysis|product_analysis|technology_research|competitor_analysis|industry_report|other\",\n  \"language\": \"vi\"\n}\n\nChỉ trả về JSON thuần túy."
      },
      "id": "d8fafe17-4e95-4400-bf3c-fe1c2256d7e5",
      "name": "Gemini: Parse Request",
