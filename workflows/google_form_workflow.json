{
  "name": "Google Form to Email & Slack",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Google Sheets Trigger (Form Responses)",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "position": [
        200,
        300
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Chào mừng bạn đã đăng ký!",
        "message": "Xin chào {{ $json['Họ và tên'] }},\n\nCảm ơn bạn đã để lại thông tin. Đội ngũ tư vấn của chúng tôi sẽ liên hệ với bạn trong thời gian sớm nhất.\n\nTrân trọng,\nĐội ngũ CSKH",
        "options": {}
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "position": [
        500,
        150
      ],
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "channel": "#sales",
        "text": "=🎉 *Khách hàng mới từ Google Form!*\n\n*Họ và tên:* {{ $json['Họ và tên'] }}\n*Email:* {{ $json.Email }}\n*Số điện thoại:* {{ $json['Số điện thoại'] }}",
        "otherOptions": {}
      },
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.slack",
      "position": [
        500,
        450
      ],
      "typeVersion": 2.1
    }
  ],
  "connections": {
    "Google Sheets Trigger (Form Responses)": {
      "main": [
        [
          {
            "node": "Send Welcome Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
